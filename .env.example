# =============================================================================
# Spring Pal Lead Generation Website - Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local or expose secret keys to the browser.
# =============================================================================

# Supabase Project URL (Found in Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key / Secret Key (SERVER-SIDE ONLY - NEVER prefix with NEXT_PUBLIC_)
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key

# Secret key used to sign short-lived lead update tokens (HMAC-SHA256)
# Generate a strong random 32+ byte secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEAD_TOKEN_SECRET=replace-with-a-random-64-char-hex-secret

# Optional: Lead update token time-to-live in minutes (default: 30)
LEAD_TOKEN_TTL_MINUTES=30
